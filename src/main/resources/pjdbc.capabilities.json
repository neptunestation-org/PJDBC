{
  "version": "1.0",
  "drivers": [
    {
      "name": "CatDriver",
      "prefix": "cat",
      "class": "org.pjdbc.drivers.CatDriver",
      "description": "Pass-through driver that forwards all calls unchanged",
      "capabilities": ["passthrough"],
      "parameters": [],
      "sideEffects": {},
      "composable": true,
      "terminal": false
    },
    {
      "name": "LogDriver",
      "prefix": "log",
      "class": "org.pjdbc.drivers.LogDriver",
      "description": "Logs all SQL statements using java.util.logging",
      "capabilities": ["logging", "passthrough"],
      "parameters": [],
      "sideEffects": {
        "logging": true
      },
      "composable": true,
      "terminal": false
    },
    {
      "name": "FilterDriver",
      "prefix": "filter",
      "class": "org.pjdbc.drivers.FilterDriver",
      "description": "Transforms SQL statements using a configurable JdbcTransformer",
      "capabilities": ["transformation", "filtering"],
      "parameters": [
        {
          "name": "class",
          "type": "string",
          "description": "Fully qualified class name of JdbcTransformer implementation"
        }
      ],
      "sideEffects": {},
      "composable": true,
      "terminal": false
    },
    {
      "name": "PoolDriver",
      "prefix": "pool",
      "class": "org.pjdbc.drivers.PoolDriver",
      "description": "Connection pooling driver with configurable parameters",
      "capabilities": ["pooling"],
      "parameters": [
        {
          "name": "min",
          "type": "integer",
          "description": "Minimum pool size",
          "default": 0,
          "min": 0
        },
        {
          "name": "max",
          "type": "integer",
          "description": "Maximum pool size (0 = unlimited)",
          "default": 0,
          "min": 0
        },
        {
          "name": "timeout",
          "type": "integer",
          "description": "Connection acquisition timeout in milliseconds",
          "default": 1000,
          "min": 0
        }
      ],
      "sideEffects": {
        "stateful": true
      },
      "composable": true,
      "terminal": false
    },
    {
      "name": "HikariPoolDriver",
      "prefix": "hikaricp",
      "class": "org.pjdbc.drivers.HikariPoolDriver",
      "description": "Connection pooling using HikariCP",
      "capabilities": ["pooling"],
      "parameters": [
        {
          "name": "maximumPoolSize",
          "type": "integer",
          "description": "Maximum pool size",
          "default": 10,
          "min": 1
        },
        {
          "name": "minimumIdle",
          "type": "integer",
          "description": "Minimum idle connections",
          "default": 10,
          "min": 0
        },
        {
          "name": "connectionTimeout",
          "type": "integer",
          "description": "Connection timeout in milliseconds",
          "default": 30000,
          "min": 250
        },
        {
          "name": "idleTimeout",
          "type": "integer",
          "description": "Idle timeout in milliseconds",
          "default": 600000,
          "min": 10000
        },
        {
          "name": "maxLifetime",
          "type": "integer",
          "description": "Max connection lifetime in milliseconds",
          "default": 1800000,
          "min": 30000
        }
      ],
      "dependencies": [
        {
          "groupId": "com.zaxxer",
          "artifactId": "HikariCP",
          "version": "5.1.0",
          "optional": false
        }
      ],
      "sideEffects": {
        "stateful": true
      },
      "composable": true,
      "terminal": false
    },
    {
      "name": "TeeDriver",
      "prefix": "tee",
      "class": "org.pjdbc.drivers.TeeDriver",
      "description": "Replicates operations across multiple database connections",
      "capabilities": ["replication"],
      "parameters": [],
      "sideEffects": {
        "stateful": true
      },
      "composable": true,
      "terminal": false
    },
    {
      "name": "UserMapDriver",
      "prefix": "mapuser",
      "class": "org.pjdbc.drivers.UserMapDriver",
      "description": "Maps application usernames to database credentials",
      "capabilities": ["security", "transformation"],
      "parameters": [],
      "sideEffects": {
        "filesystem": true
      },
      "composable": true,
      "terminal": false
    },
    {
      "name": "SinkDriver",
      "prefix": "sink",
      "class": "org.pjdbc.drivers.SinkDriver",
      "description": "Discards all SQL operations",
      "capabilities": ["testing"],
      "parameters": [],
      "sideEffects": {},
      "composable": true,
      "terminal": true
    },
    {
      "name": "MockDriver",
      "prefix": "mock",
      "class": "org.pjdbc.drivers.MockDriver",
      "description": "In-memory mock driver for testing",
      "capabilities": ["testing"],
      "parameters": [],
      "sideEffects": {
        "stateful": true
      },
      "composable": false,
      "terminal": true
    },
    {
      "name": "ReadonlyDriver",
      "prefix": "readonly",
      "class": "org.pjdbc.drivers.ReadonlyDriver",
      "description": "Enforces read-only database access",
      "capabilities": ["security", "filtering"],
      "parameters": [
        {
          "name": "allowDDL",
          "type": "boolean",
          "description": "Allow DDL statements (CREATE, ALTER, DROP)",
          "default": false
        },
        {
          "name": "allowDML",
          "type": "boolean",
          "description": "Allow DML statements (INSERT, UPDATE, DELETE)",
          "default": false
        },
        {
          "name": "message",
          "type": "string",
          "description": "Custom error message for blocked operations"
        }
      ],
      "sideEffects": {},
      "composable": true,
      "terminal": false
    },
    {
      "name": "RetryDriver",
      "prefix": "retry",
      "class": "org.pjdbc.drivers.RetryDriver",
      "description": "Automatically retries failed queries on transient errors",
      "capabilities": ["resilience"],
      "parameters": [
        {
          "name": "maxRetries",
          "type": "integer",
          "description": "Maximum retry attempts",
          "default": 3,
          "min": 0
        },
        {
          "name": "initialDelay",
          "type": "integer",
          "description": "Initial delay in ms before first retry",
          "default": 100,
          "min": 0
        },
        {
          "name": "maxDelay",
          "type": "integer",
          "description": "Maximum delay cap in ms",
          "default": 5000,
          "min": 0
        },
        {
          "name": "backoffMultiplier",
          "type": "float",
          "description": "Multiplier for exponential backoff",
          "default": 2.0,
          "min": 1.0
        },
        {
          "name": "jitter",
          "type": "boolean",
          "description": "Add random jitter to delays",
          "default": true
        },
        {
          "name": "retryOnSqlStates",
          "type": "string",
          "description": "Semicolon-separated SQL states to retry on"
        }
      ],
      "sideEffects": {},
      "composable": true,
      "terminal": false
    },
    {
      "name": "CircuitBreakerDriver",
      "prefix": "circuitbreaker",
      "class": "org.pjdbc.drivers.CircuitBreakerDriver",
      "description": "Implements circuit breaker pattern for fault tolerance with CLOSED/OPEN/HALF_OPEN states",
      "capabilities": ["resilience"],
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "description": "Circuit breaker name for monitoring",
          "default": "default"
        },
        {
          "name": "failureThreshold",
          "type": "integer",
          "description": "Failures before opening circuit",
          "default": 5,
          "min": 1
        },
        {
          "name": "successThreshold",
          "type": "integer",
          "description": "Successes in half-open to close circuit",
          "default": 1,
          "min": 1
        },
        {
          "name": "resetTimeout",
          "type": "integer",
          "description": "Time in ms before open -> half-open",
          "default": 30000,
          "min": 1
        }
      ],
      "sideEffects": {
        "stateful": true
      },
      "composable": true,
      "terminal": false
    },
    {
      "name": "TimeoutDriver",
      "prefix": "timeout",
      "class": "org.pjdbc.drivers.TimeoutDriver",
      "description": "Enforces query timeout limits on all statements",
      "capabilities": ["resilience"],
      "parameters": [
        {
          "name": "queryTimeout",
          "type": "integer",
          "description": "Query timeout in seconds (0 = no timeout)",
          "default": 30,
          "min": 0
        },
        {
          "name": "cancelOnTimeout",
          "type": "boolean",
          "description": "Whether to attempt cancellation on timeout",
          "default": true
        }
      ],
      "sideEffects": {},
      "composable": true,
      "terminal": false
    },
    {
      "name": "ChaosDriver",
      "prefix": "chaos",
      "class": "org.pjdbc.drivers.ChaosDriver",
      "description": "Injects configurable failures and latency for resilience testing",
      "capabilities": ["testing", "resilience"],
      "parameters": [
        {
          "name": "failureRate",
          "type": "float",
          "description": "Probability of throwing SQLException per query",
          "default": 0.0,
          "min": 0.0,
          "max": 1.0
        },
        {
          "name": "latency",
          "type": "integer",
          "description": "Fixed delay in milliseconds before each query",
          "default": 0,
          "min": 0
        },
        {
          "name": "latencyVariance",
          "type": "integer",
          "description": "Random additional delay up to this value in ms",
          "default": 0,
          "min": 0
        },
        {
          "name": "connectionDropRate",
          "type": "float",
          "description": "Probability of closing connection unexpectedly",
          "default": 0.0,
          "min": 0.0,
          "max": 1.0
        },
        {
          "name": "resultSetLatency",
          "type": "integer",
          "description": "Delay in ms for each ResultSet.next() call",
          "default": 0,
          "min": 0
        },
        {
          "name": "exceptionMessage",
          "type": "string",
          "description": "Custom exception message",
          "default": "ChaosDriver: Induced failure"
        }
      ],
      "sideEffects": {},
      "composable": true,
      "terminal": false
    },
    {
      "name": "CachingDriver",
      "prefix": "cache",
      "class": "org.pjdbc.drivers.CachingDriver",
      "description": "Caches SELECT query results in memory",
      "capabilities": ["caching"],
      "parameters": [
        {
          "name": "ttl",
          "type": "integer",
          "description": "Time-to-live in seconds",
          "default": 60,
          "min": 1
        },
        {
          "name": "maxSize",
          "type": "integer",
          "description": "Maximum cached queries with LRU eviction",
          "default": 1000,
          "min": 1
        },
        {
          "name": "invalidateOnWrite",
          "type": "boolean",
          "description": "Clear cache on writes",
          "default": true
        },
        {
          "name": "enabled",
          "type": "boolean",
          "description": "Enable caching",
          "default": true
        }
      ],
      "sideEffects": {
        "stateful": true
      },
      "composable": true,
      "terminal": false
    },
    {
      "name": "RedisCachingDriver",
      "prefix": "rediscache",
      "class": "org.pjdbc.drivers.RedisCachingDriver",
      "description": "Caches SELECT query results in Redis",
      "capabilities": ["caching"],
      "parameters": [
        {
          "name": "host",
          "type": "string",
          "description": "Redis server hostname",
          "default": "localhost"
        },
        {
          "name": "port",
          "type": "integer",
          "description": "Redis server port",
          "default": 6379,
          "min": 1,
          "max": 65535
        },
        {
          "name": "password",
          "type": "string",
          "description": "Redis password"
        },
        {
          "name": "database",
          "type": "integer",
          "description": "Redis database number",
          "default": 0,
          "min": 0
        },
        {
          "name": "keyPrefix",
          "type": "string",
          "description": "Prefix for cache keys",
          "default": "pjdbc:"
        },
        {
          "name": "ttl",
          "type": "integer",
          "description": "Time-to-live in seconds",
          "default": 60,
          "min": 1
        },
        {
          "name": "maxPoolSize",
          "type": "integer",
          "description": "Maximum connections in pool",
          "default": 8,
          "min": 1
        },
        {
          "name": "invalidateOnWrite",
          "type": "boolean",
          "description": "Clear cache on writes",
          "default": true
        },
        {
          "name": "enabled",
          "type": "boolean",
          "description": "Enable caching",
          "default": true
        }
      ],
      "dependencies": [
        {
          "groupId": "redis.clients",
          "artifactId": "jedis",
          "version": "5.1.0",
          "optional": true
        }
      ],
      "sideEffects": {
        "network": true,
        "stateful": true
      },
      "composable": true,
      "terminal": false
    },
    {
      "name": "MemcachedCachingDriver",
      "prefix": "memcache",
      "class": "org.pjdbc.drivers.MemcachedCachingDriver",
      "description": "Caches SELECT query results in Memcached",
      "capabilities": ["caching"],
      "parameters": [
        {
          "name": "servers",
          "type": "string",
          "description": "Semicolon-separated list of host:port",
          "default": "localhost:11211"
        },
        {
          "name": "keyPrefix",
          "type": "string",
          "description": "Prefix for cache keys",
          "default": "pjdbc:"
        },
        {
          "name": "ttl",
          "type": "integer",
          "description": "Time-to-live in seconds",
          "default": 60,
          "min": 1
        },
        {
          "name": "invalidateOnWrite",
          "type": "boolean",
          "description": "Clear cache on writes",
          "default": true
        },
        {
          "name": "enabled",
          "type": "boolean",
          "description": "Enable caching",
          "default": true
        }
      ],
      "dependencies": [
        {
          "groupId": "net.spy",
          "artifactId": "spymemcached",
          "version": "2.12.3",
          "optional": true
        }
      ],
      "sideEffects": {
        "network": true,
        "stateful": true
      },
      "composable": true,
      "terminal": false
    },
    {
      "name": "HazelcastCachingDriver",
      "prefix": "hazelcast",
      "class": "org.pjdbc.drivers.HazelcastCachingDriver",
      "description": "Caches SELECT query results in Hazelcast",
      "capabilities": ["caching"],
      "parameters": [
        {
          "name": "mode",
          "type": "string",
          "description": "Hazelcast mode",
          "default": "embedded",
          "enum": ["embedded", "client"]
        },
        {
          "name": "clusterName",
          "type": "string",
          "description": "Hazelcast cluster name",
          "default": "pjdbc-cache"
        },
        {
          "name": "members",
          "type": "string",
          "description": "Semicolon-separated member addresses",
          "default": "127.0.0.1:5701"
        },
        {
          "name": "mapName",
          "type": "string",
          "description": "IMap name for caching",
          "default": "pjdbc_query_cache"
        },
        {
          "name": "ttl",
          "type": "integer",
          "description": "Time-to-live in seconds",
          "default": 60,
          "min": 1
        },
        {
          "name": "maxIdle",
          "type": "integer",
          "description": "Maximum idle time in seconds (0 to disable)",
          "default": 0,
          "min": 0
        },
        {
          "name": "invalidateOnWrite",
          "type": "boolean",
          "description": "Clear cache on writes",
          "default": true
        },
        {
          "name": "enabled",
          "type": "boolean",
          "description": "Enable caching",
          "default": true
        }
      ],
      "dependencies": [
        {
          "groupId": "com.hazelcast",
          "artifactId": "hazelcast",
          "version": "5.3.6",
          "optional": true
        }
      ],
      "sideEffects": {
        "network": true,
        "stateful": true
      },
      "composable": true,
      "terminal": false
    },
    {
      "name": "TracingDriver",
      "prefix": "trace",
      "class": "org.pjdbc.drivers.TracingDriver",
      "description": "Provides distributed tracing for JDBC operations",
      "capabilities": ["tracing"],
      "parameters": [
        {
          "name": "tracerName",
          "type": "string",
          "description": "Registered tracer name",
          "default": "jdbc"
        },
        {
          "name": "spanPrefix",
          "type": "string",
          "description": "Prefix for span names",
          "default": "db."
        },
        {
          "name": "includeSql",
          "type": "boolean",
          "description": "Include SQL in spans",
          "default": true
        },
        {
          "name": "includeParams",
          "type": "boolean",
          "description": "Include parameter values",
          "default": false
        },
        {
          "name": "includeRowCount",
          "type": "boolean",
          "description": "Include row counts",
          "default": true
        }
      ],
      "sideEffects": {
        "stateful": true
      },
      "composable": true,
      "terminal": false
    },
    {
      "name": "MetricsDriver",
      "prefix": "metrics",
      "class": "org.pjdbc.drivers.MetricsDriver",
      "description": "Collects performance metrics for JDBC operations",
      "capabilities": ["metrics"],
      "parameters": [
        {
          "name": "enabled",
          "type": "boolean",
          "description": "Enable metrics collection",
          "default": true
        },
        {
          "name": "slowThreshold",
          "type": "integer",
          "description": "Threshold in ms for slow query detection",
          "default": 1000,
          "min": 0
        },
        {
          "name": "trackByType",
          "type": "boolean",
          "description": "Track metrics by operation type",
          "default": true
        }
      ],
      "sideEffects": {
        "metrics": true,
        "stateful": true
      },
      "composable": true,
      "terminal": false
    },
    {
      "name": "DataMaskingDriver",
      "prefix": "mask",
      "class": "org.pjdbc.drivers.DataMaskingDriver",
      "description": "Masks sensitive data in query results",
      "capabilities": ["masking", "security"],
      "parameters": [
        {
          "name": "columns",
          "type": "string",
          "description": "Semicolon-separated column name patterns (regex) to mask"
        },
        {
          "name": "strategy",
          "type": "string",
          "description": "Masking strategy",
          "default": "PARTIAL",
          "enum": ["FULL", "PARTIAL", "EMAIL", "REDACT", "HASH"]
        },
        {
          "name": "mask",
          "type": "string",
          "description": "Mask character",
          "default": "*"
        },
        {
          "name": "showFirst",
          "type": "integer",
          "description": "Characters to show at start for PARTIAL",
          "default": 0,
          "min": 0
        },
        {
          "name": "showLast",
          "type": "integer",
          "description": "Characters to show at end for PARTIAL",
          "default": 4,
          "min": 0
        }
      ],
      "sideEffects": {},
      "composable": true,
      "terminal": false
    }
  ]
}
